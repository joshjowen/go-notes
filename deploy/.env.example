# Copy to deploy/.env and fill in. Compose reads it automatically.
#
# Generate each secret with:  openssl rand -hex 32

# The origin a browser sees. Must match the Caddyfile, and must not end in "/".
PUBLIC_URL=https://notes.example.com

# Where Authelia lives; go-notes appends /.well-known/openid-configuration.
OIDC_ISSUER_URL=https://auth.example.com

# The plaintext half of the client secret. Authelia stores only its digest —
# see the README for how to produce the pair.
OIDC_CLIENT_SECRET=

POSTGRES_PASSWORD=

# Where your markdown lives on the host. Point this at real storage, not a
# temporary directory: this is the vault.
NOTES_DIR=./data/notes

# Rootless Podman needs the default below so bind-mounted notes end up owned by
# you. On Docker, set this to empty.
# USERNS_MODE=

# Suggested links, served by the `embeddings` container on this host. Set to
# false to switch the feature off; you can then stop that container too.
EMBEDDINGS_ENABLED=true

# How alike two passages must be before the graph draws a suggestion. BGE's
# scores sit high — dissimilar text still scores above 0.5 — so this is the
# number to reach for if the graph looks like everything is related to
# everything, or like nothing is. See the README for how to look at what you
# actually got.
EMBEDDINGS_MIN_SCORE=0.82

# Only needed if you point EMBEDDINGS_API_BASE at somebody else's server
# instead of the container. Doing that sends the text of your notes to them.
# EMBEDDINGS_API_BASE=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small

TZ=Europe/London
RUST_LOG=info
