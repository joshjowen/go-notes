[Unit]
Description=go-notes
Requires=go-notes-postgres.container
After=go-notes-postgres.container

[Container]
ContainerName=go-notes
Image=localhost/go-notes:latest
AutoUpdate=local

Network=go-notes.network

# The two mappings that make rootless Podman behave.
#
# `keep-id` maps the container's UID 1000 back to *your* user on the host, so
# the markdown files land owned by you and are readable over SSH without sudo.
# Without it they would be owned by an unmapped subuid and effectively
# untouchable outside the container.
UserNS=keep-id:uid=1000,gid=1000

# `:Z` relabels the mount for SELinux, which Fedora and RHEL enforce. Omit it
# and the container gets permission denied on a directory that looks
# world-writable. Use `:z` instead if the same directory is shared with another
# container.
Volume=%h/notes:/data/notes:Z
Volume=%h/.config/go-notes:/config:Z

Environment=GO_NOTES__SERVER__DATA_DIR=/data/notes
Environment=GO_NOTES__AUTH__LOCAL__USERS_FILE=/config/users.json
Environment=RUST_LOG=info

# Suggested links, served by go-notes-embeddings.container on this host, so the
# text of your notes never leaves it. Point API_BASE at a hosted provider and
# that stops being true — a different decision, worth making deliberately.
# Drop ENABLED to false (and stop that unit) to switch the feature off.
Environment=GO_NOTES__EMBEDDINGS__ENABLED=true
Environment=GO_NOTES__EMBEDDINGS__API_BASE=http://go-notes-embeddings:80/v1
Environment=GO_NOTES__EMBEDDINGS__MODEL=BAAI/bge-base-en-v1.5
# BGE's scores sit high, so this is the number to reach for if the graph
# suggests too much or too little. The README says how to look at what you got.
Environment=GO_NOTES__EMBEDDINGS__MIN_SCORE=0.82
EnvironmentFile=%h/.config/go-notes/go-notes.env

# Rootless cannot bind below 1024 without granting the capability, so this sits
# on 8080 and Caddy (or a host reverse proxy) fronts it.
PublishPort=127.0.0.1:8080:8080

HealthCmd=/usr/local/bin/go-notes healthcheck
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s

# Nothing in the container needs to write outside the volumes.
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
